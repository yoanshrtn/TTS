# ============================================================
# FUNGSI MEMBUAT INPUT KOTAK HURUF
# ============================================================

def buat_kotak_huruf(answer, question_id, hint_data=None):
    """
    Membuat kotak-kotak input sesuai jumlah huruf jawaban.

    answer:
        Jawaban nyeleneh yang harus ditebak.

    question_id:
        ID unik soal agar key Streamlit tidak bentrok.

    hint_data:
        Tuple (posisi, huruf) untuk hint.
    """

    letters = []

    # Ambil hint
    hint_position = None
    hint_letter = None

    if hint_data:
        hint_position, hint_letter = hint_data

    cols = st.columns(len(answer))

    for i, col in enumerate(cols):

        # Kalau posisi ini merupakan huruf hint
        default_value = ""

        if hint_position == i:
            default_value = hint_letter.upper()

        with col:
            value = st.text_input(
                label=f"Huruf {i+1}",
                value=default_value,
                max_chars=1,
                key=f"{question_id}_letter_{i}",
                label_visibility="collapsed",
                placeholder="_"
            ).strip().lower()

        letters.append(value)

    return "".join(letters)


